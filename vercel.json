{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4",
      "excludeFiles": "{.git,logs,tmp,node_modules,firebase,frontend,tests,bin,*.md,*.pdf,webroot/uploads,vendor/cakephp/{debug_kit,phpunit,codesniffer,bake},vendor/**/{tests,test,*.md,.git}}/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "COMPOSER_NO_DEV": "1",
    "COMPOSER_INSTALL_OPTIONS": "--no-dev --classmap-authoritative --no-progress --optimize-autoloader"
  }
}


