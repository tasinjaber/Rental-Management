{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4",
      "excludeFiles": "{.git,logs,tmp,node_modules,firebase,frontend,tests,bin,*.md,*.pdf,webroot/uploads,vendor/cakephp/{debug_kit,phpunit,codesniffer,bake},vendor/google,vendor/tecnickcom/tcpdf/{fonts,examples,tools},vendor/**/{tests,test,*.md,.git,docs,doc}}/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
